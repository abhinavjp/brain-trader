# LLM Providers — set the key for your chosen provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Data Providers
ALPHA_VANTAGE_API_KEY=

# Enterprise (Azure OpenAI) — see docs for full config
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Runtime overrides (optional)
BRAIN_TRADER_LLM__PROVIDER=openai
BRAIN_TRADER_LLM__DEEP_MODEL=gpt-5.4
BRAIN_TRADER_LLM__QUICK_MODEL=gpt-5.4-mini
BRAIN_TRADER_RESULTS_DIR=~/.brain_trader/logs
BRAIN_TRADER_CACHE_DIR=~/.brain_trader/cache
BRAIN_TRADER_MEMORY_LOG_PATH=~/.brain_trader/memory/decisions.db
